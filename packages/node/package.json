{
  "name": "@qubiq-psp/sdk",
  "version": "0.3.0",
  "description": "Node.js SDK for the PSP merchant API: signed requests to all 27 methods (invoices, balances, operations, deposits, payouts, networks, tariff, webhooks), payment widget links and webhook signature verification",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qubiq-psp/sdk.git",
    "directory": "packages/node"
  },
  "homepage": "https://github.com/qubiq-psp/sdk/tree/main/packages/node#readme",
  "bugs": {
    "url": "https://github.com/qubiq-psp/sdk/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "keywords": [
    "psp",
    "payments",
    "crypto",
    "usdt",
    "tron",
    "evm",
    "invoices",
    "webhooks",
    "hmac",
    "sdk",
    "payouts",
    "balances"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc && tsc -p examples",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:sync": "node scripts/api-sync.mjs",
    "api:check": "node scripts/api-sync.mjs --check",
    "package:check": "publint --strict --pack npm && attw --pack .",
    "prepack": "tsup",
    "ci": "pnpm run api:check && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build && pnpm run package:check && pnpm run smoke",
    "smoke": "node scripts/smoke.mjs",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@types/express": "^5",
    "@types/node": "^18.19.130",
    "eslint": "^9.39",
    "express": "^5",
    "fastify": "^5",
    "openapi-typescript": "^7.13",
    "prettier": "^3.6",
    "publint": "^0.3.25",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "tsup": "^8.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46",
    "vitest": "^4.1.12"
  }
}
