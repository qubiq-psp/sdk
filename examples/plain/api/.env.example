# examples/plain/api — the environment (README, "Environment"). Copy to .env and fill in; .env is never committed.
# Empty value = unset (the default applies). The names are the ones @qubiq-psp/sdk reads, so both example backends
# share one .env.

# Merchant API origin, no path. https only (plain http only for localhost / 127.0.0.1).
PSP_API_URL=https://api.psp.qubiq.cc
# Your test API key and secret from the cabinet. Never commit or log the secret.
PSP_API_KEY=psp_pk_test_REPLACE_WITH_24_CHARACTERS
PSP_API_SECRET=psp_sk_test_REPLACE_WITH_36_CHARACTERS_OF_SECRET
# During a secret rotation only: the previous secret, so webhooks signed with it are still accepted.
PSP_API_PREVIOUS_SECRET=
# Origin of the payment page; widget links are {PSP_CHECKOUT_URL}/#<token>.
PSP_CHECKOUT_URL=https://pay.psp.qubiq.cc

# Public origin of this deployment. The webhook URL to set in the platform is {APP_PUBLIC_URL}/webhooks/psp.
APP_PUBLIC_URL=
# true (default): refuse to start with a live key psp_pk_live_… or a live secret psp_sk_live_….
APP_TESTNET_ONLY=true

HOST=127.0.0.1
PORT=4600
# A built examples/ui folder to serve (with SPA fallback); empty — API only.
APP_UI_DIR=
# Request-log entries and received webhooks kept in memory, each.
APP_LOG_LIMIT=1000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
