# Dev server only (pnpm dev): where Vite proxies /api and /webhooks. plain listens on 4600, sdk on 4900.
VITE_BACKEND_URL=http://127.0.0.1:4600
# The widget of `pnpm dev`: sdk (<PspCheckout> of @qubiq-psp/react, the default) or plain (own iframe).
# `pnpm dev:plain` and the builds (`build:sdk`, `build:plain`) choose it themselves.
UI_VARIANT=sdk
