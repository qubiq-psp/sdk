# Copy to .env (git-ignored) and fill in. Variables of the process win over .env.
# One merchant per deployment: the key pair of one test merchant from the merchant cabinet (Integration → API keys).

# Merchant API (the names @qubiq-psp/sdk reads itself)
PSP_API_URL=https://api.psp.qubiq.cc
PSP_API_KEY=psp_pk_test_…
PSP_API_SECRET=psp_sk_test_…
# Only during a secret rotation: the receiver also accepts webhooks signed with it
PSP_API_PREVIOUS_SECRET=
# The payment page of the widget links
PSP_CHECKOUT_URL=https://pay.psp.qubiq.cc

# Public URL of this deployment; the webhook URL is ${APP_PUBLIC_URL}/webhooks/psp (empty: no webhook URL)
APP_PUBLIC_URL=
# true (the default; unset or empty is true too): refuse to start with a psp_pk_live_… key or a psp_sk_live_… secret.
# Only false turns it off — for a local run against mainnet, never in a deployment
APP_TESTNET_ONLY=true

HOST=127.0.0.1
PORT=4900
# A built examples/ui to serve, with an SPA fallback (empty: the API only)
APP_UI_DIR=
# Request-log entries and received webhooks kept in memory, and at most this many bytes of each log (32 MB)
APP_LOG_LIMIT=1000
APP_LOG_MAX_BYTES=33554432
# Timeout of one attempt to the platform, ms (the platform answers any request within 180 s)
APP_UPSTREAM_TIMEOUT_MS=180000
# error, warn, log, debug (every SDK attempt), verbose
LOG_LEVEL=log
